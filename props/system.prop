# App launch prefetching (IORapd)
ro.iorapd.enable=false
iorapd.perfetto.enable=false
iorapd.readahead.enable=false
persist.device_config.runtime_native_boot.iorap_readahead_enable=false

# Camera
log.tag.CHIUSECASE=ERROR

# CNE
persist.vendor.cne.feature=1

# Dalvik / ART — dex2oat parallelism (garnet: cpu0-3 A55, cpu4-7 A78)
dalvik.vm.boot-dex2oat-threads=8
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.dex2oat-threads=8
dalvik.vm.dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.image-dex2oat-threads=8
dalvik.vm.dex2oat-swap=false
# Background dexopt pinned to the little cores (heat/battery)
dalvik.vm.background-dex2oat-threads=4
dalvik.vm.background-dex2oat-cpu-set=0,1,2,3

# Deep Sleep
pm.sleep_mode=1

# Device
ro.product.mod_device=garnet_global

# Disable FPS capping for games
debug.graphics.game_default_frame_rate.disabled=true

# Display
debug.sf.frame_rate_multiple_threshold=120
persist.sysui.blur_radius=30

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# SQLite — WAL sync NORMAL: fewer fsyncs; last transaction may be lost
# on sudden power loss, no corruption risk
debug.sqlite.wal.syncmode=NORMAL

# StrictMode off (user build; minor overhead reduction)
persist.sys.strictmode.disable=true

# Log
persist.log.tag.ACDB-LOADER=S
persist.log.tag.CamX=S
persist.log.tag.CHIUSECASE=S
persist.log.tag.CVP=S
persist.log.tag.ResourcesCompat=S
persist.log.tag.SYNX-UMD=S
persist.log.tag.AnalyticsService=S
persist.log.tag.KernelCpuUidActiveTimeReader=S
persist.log.tag.Tracer=S
persist.log.tag.NearbySharing=S
persist.log.tag.IntervalStats=S
persist.log.tag.CompatibilityChangeReporter=S
persist.log.tag.SQLiteLog=S
persist.log.tag.wificond=S
persist.log.tag.b/223498680=S
persist.log.tag.TrafficStats=S
persist.log.tag.ContrastColorUtil=S
persist.log.tag.OpenGLRenderer=S
persist.log.tag.ultrasound_extn=S
persist.log.tag.minksocket=S

# QTI
ro.vendor.qti.va_aosp.support=1

# QTI Mem Optimisation
persist.vendor.sys.memplus.enable=false
ro.vendor.qti.sys.fw.bg_apps_limit=30
ro.vendor.qti.sys.fw.bservice_limit=60

# Radio
persist.vendor.data.mode=concurrent
persist.rcs.supported=1
ro.telephony.default_network=33,33
persist.vendor.vonr_setting_support=1
