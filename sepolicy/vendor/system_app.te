#Thermal
allow system_app sysfs_thermal:file { rw_file_perms getattr write };

# Allow system_app to access a get true info
allow system_app proc_stat:file read;
allow system_app sysfs_thermal:file write;
allow system_app vendor_sysfs_kgsl:file read;
allow system_app vendor_sysfs_kgsl_gpuclk:file read;
allow system_app proc_stat:file open;
allow system_app vendor_sysfs_kgsl:file open;
allow system_app vendor_sysfs_kgsl_gpuclk:file open;
allow system_app proc_stat:file { getattr open read };
allow system_app vendor_sysfs_kgsl:file { getattr open read };
allow system_app vendor_sysfs_kgsl_gpuclk:file { getattr open read };

# Performance mode
allow system_app sysfs_devices_system_cpu:file rw_file_perms;
allow system_app sysfs_kgsl:file rw_file_perms;
allow system_app sysfs_kgsl:dir r_dir_perms;

# Charge Bypass
allow system_app vendor_sysfs_battery_supply:dir search;
allow system_app vendor_sysfs_battery_supply:file { getattr open read write };

# Core Control
allow system_app vendor_sysfs_corecontrol:dir search;
allow system_app vendor_sysfs_corecontrol:file { getattr open read write };

# Allow KProfiles to be adjusted by a system app
allow system_app sysfs_kprofiles:file rw_file_perms;

# HBM
allow system_app vendor_sysfs_graphics:dir search;
allow system_app vendor_sysfs_graphics:file { getattr open read write };
