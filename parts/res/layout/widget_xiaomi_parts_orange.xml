<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_root_bg">

    <!-- ==================== FEJLÉC ==================== -->
    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/iv_header_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_xiaomiparts"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/iv_header_icon"
            android:layout_marginStart="10dp"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_header_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_forward"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

    </RelativeLayout>

    <!-- ==================== CPU GOVERNOR ==================== -->
    <LinearLayout
        android:id="@+id/card_governor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="14dp"
        android:layout_marginBottom="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/ic_gov_label"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_cpu_governor_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="26dp"
                android:text="@string/widget_cpu_governor_label"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tv_gov_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <ImageButton
                android:id="@+id/btn_gov_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_left"
                android:background="@drawable/widget_btn_circle_bg_orange_selector"
                android:contentDescription="@string/widget_gov_prev" />

            <TextView
                android:id="@+id/tv_gov_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_gov_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                android:background="@drawable/widget_btn_circle_bg_orange_selector"
                android:contentDescription="@string/widget_gov_next" />

        </RelativeLayout>
    </LinearLayout>

    <!-- ==================== DISPLAY HZ + HBM (2 oszlop) ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- BAL: Display Hz -->
        <LinearLayout
            android:id="@+id/card_hz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="12dp"
            android:layout_marginEnd="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:id="@+id/ic_hz_label"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_refresh_rate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="22dp"
                    android:text="@string/widget_display_hz"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"
                    android:textAllCaps="true" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_hz_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/widget_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="10dp">

                <ImageButton
                    android:id="@+id/btn_hz_dec"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_remove"
                    android:background="@drawable/widget_btn_circle_bg_orange_selector"
                    android:contentDescription="@string/widget_hz_dec" />

                <ImageButton
                    android:id="@+id/btn_hz_inc"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_add"
                    android:background="@drawable/widget_btn_circle_bg_orange_selector"
                    android:contentDescription="@string/widget_hz_inc" />

            </RelativeLayout>
        </LinearLayout>

        <!-- JOBB: HBM kapcsoló -->
        <LinearLayout
            android:id="@+id/card_hbm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="14dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_hbm_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_hbm_off"
                android:scaleType="centerInside"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="HBM"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_hbm_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ==================== CPU FREKVENCIA SZABÁLYZÓK ==================== -->
    <LinearLayout
        android:id="@+id/card_cpu_freq_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <!-- A55 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A55 (efficiency)"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_a55_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageButton
                    android:id="@+id/btn_a55_dec"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_remove"
                    android:background="@drawable/widget_btn_circle_bg_orange_selector"
                    android:contentDescription="Decrease A55 max freq" />

                <ProgressBar
                    android:id="@+id/pb_a55_slider"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:max="8"
                    android:progress="8"
                    android:progressTint="#FF9800"
                    android:progressBackgroundTint="#33FF9800"
                    android:minHeight="6dp"
                    android:maxHeight="6dp" />

                <ImageButton
                    android:id="@+id/btn_a55_inc"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_add"
                    android:background="@drawable/widget_btn_circle_bg_orange_selector"
                    android:contentDescription="Increase A55 max freq" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_text_secondary"
            android:layout_marginVertical="8dp" />

        <!-- A78 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A78 (performance)"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_a78_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageButton
                    android:id="@+id/btn_a78_dec"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_remove"
                    android:background="@drawable/widget_btn_circle_bg_orange_selector"
                    android:contentDescription="Decrease A78 max freq" />

                <ProgressBar
                    android:id="@+id/pb_a78_slider"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:max="11"
                    android:progress="11"
                    android:progressTint="#FF9800"
                    android:progressBackgroundTint="#33FF9800"
                    android:minHeight="6dp"
                    android:maxHeight="6dp" />

                <ImageButton
                    android:id="@+id/btn_a78_inc"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_add"
                    android:background="@drawable/widget_btn_circle_bg_orange_selector"
                    android:contentDescription="Increase A78 max freq" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- ==================== THERMAL + PERFORMANCE MODE ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/card_thermal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="14dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_thermal_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_thermal"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/thermal_title"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_thermal_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_performance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg"
            android:padding="14dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_perf_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_performance_balanced"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Performance"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_perf_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/widget_cpu_freq_note"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp"
        android:gravity="center" />

</LinearLayout>
