<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Filter and Level Selection Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/filter_edittext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Filter logs..."
            android:textSize="14sp"
            android:padding="8dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/level_spinner"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical" />

    </LinearLayout>

    <!-- Control Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/pause_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="PAUSE"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/holo_orange_dark" />

        <Button
            android:id="@+id/autoscroll_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="AutoScroll: ON"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/holo_green_dark" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="SAVE"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/holo_blue_dark"
            android:enabled="false"
            android:alpha="0.5" />

        <Button
            android:id="@+id/clear_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="CLEAR"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="@android:color/holo_red_dark" />

    </LinearLayout>

    <!-- Status and Log Count Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Starting..."
            android:textSize="12sp"
            android:textColor="@android:color/holo_green_dark"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/log_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0 logs"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray" />

    </LinearLayout>

    <!-- Log List View -->
    <ListView
        android:id="@+id/logcat_listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:transcriptMode="normal"
        android:stackFromBottom="true"
        android:background="@android:color/black"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true" />

</LinearLayout>
