<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Section header -->
        <TextView
            android:id="@+id/system_resolution_header"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="@string/system_resolution_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Current resolution summary (e.g. "1220×2712 @ 395 dpi") -->
        <TextView
            android:id="@+id/system_resolution_summary"
            android:layout_marginTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="@string/system_resolution_summary_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Mode spinner: Default | 480p | 540p | 720p | Custom -->
        <Spinner
            android:id="@+id/system_resolution_mode"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:background="?android:attr/listDivider" />

        <!-- Custom resolution section header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/custom_resolution_section_title"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/colorAccent" />

        <!-- Info note -->
        <TextView
            android:layout_marginTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="@string/system_resolution_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
