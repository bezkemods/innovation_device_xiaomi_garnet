<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreference
        android:key="adblocker_enabled"
        android:title="@string/adblocker_enable_title"
        android:summary="@string/adblocker_enable_summary"
        android:defaultValue="false" />

    <PreferenceCategory
        android:title="@string/adblocker_status_category">

        <Preference
            android:key="adblocker_status"
            android:title="@string/adblocker_status_title"
            android:summary="@string/adblocker_status_disabled"
            android:selectable="false" />

        <Preference
            android:key="adblocker_method"
            android:title="@string/adblocker_method_title"
            android:summary="@string/adblocker_method_summary"
            android:selectable="true" />

        <Preference
            android:key="adblocker_info"
            android:title="@string/adblocker_blocked_title"
            android:summary="@string/adblocker_blocked_summary"
            android:selectable="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/adblocker_update_category">

        <Preference
            android:key="adblocker_last_update"
            android:title="@string/adblocker_last_update_title"
            android:summary="@string/adblocker_never_updated"
            android:selectable="false" />

        <Preference
            android:key="adblocker_update"
            android:title="@string/adblocker_update_title"
            android:summary="@string/adblocker_update_summary" />

        <Preference
            android:key="adblocker_manual_update"
            android:title="@string/adblocker_manual_update_title"
            android:summary="@string/adblocker_manual_update_summary" />

        <Preference
            android:key="adblocker_github"
            android:title="@string/adblocker_github_title"
            android:summary="@string/adblocker_github_summary" />

    </PreferenceCategory>

</PreferenceScreen>
