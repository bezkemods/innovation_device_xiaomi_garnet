<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWidgetProviderInfo — widget metaadatok Android 16 (API 36) számára.

    minWidth / minHeight: 4×3 cellás widget (320dp × 220dp tipikus értékek)
    targetCellWidth / targetCellHeight: Android 12+ API — kívánatos cellaméret
    updatePeriodMillis: 0 = nem frissítjük automatikusan időzítővel,
                        csak gombnyomásra + BOOT_COMPLETED-kor.
    widgetCategory: home_screen (launcher widgetek)
    widgetFeatures: reconfigurable — a felhasználó újra tudja konfigurálni
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:minWidth="320dp"
    android:minHeight="260dp"
    android:minResizeWidth="280dp"
    android:minResizeHeight="200dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="700dp"

    android:targetCellWidth="4"
    android:targetCellHeight="4"

    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_xiaomi_parts"
    android:configure="org.lineageos.settings.widget.XiaomiPartsWidgetConfigActivity"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_xiaomi_parts"

    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"

    android:description="@string/widget_description" />
