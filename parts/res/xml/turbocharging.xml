<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="turbo_enable"
        android:title="@string/pref_turbo_enable_title"
        android:summary="@string/pref_turbo_enable_summary"
        android:defaultValue="false"/>

    <SwitchPreferenceCompat
        android:key="sports_mode"
        android:title="@string/pref_sports_mode_title"
        android:summary="@string/pref_sports_mode_summary"
        android:defaultValue="false" />

    <ListPreference
        android:key="turbo_current"
        android:title="@string/pref_turbo_current_title"
        android:summary="@string/pref_turbo_current_summary"
        android:entries="@array/turbo_current_entries"
        android:entryValues="@array/turbo_current_values"
        android:defaultValue="6700000"/>
</PreferenceScreen>
