<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.lineageos.settings"
    android:sharedUserId="android.uid.system">
    
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />
    <uses-permission android:name="android.permission.MANAGE_GAME_MODE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.ACCESS_FPS_COUNTER" />
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Log broadcast permission -->
    <permission 
        android:name="org.lineageos.settings.LOGCAT_PERMISSION"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.lineageos.settings.LOGCAT_PERMISSION" />
    
    <uses-sdk
        android:minSdkVersion="33"
        android:targetSdkVersion="35"/>

    <application
        android:label="@string/xiaomi_parts_title"
        android:persistent="true"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:theme="@style/Theme.SubSettingsBase"
        android:icon="@drawable/ic_xiaomiparts">

    <receiver android:name=".BootCompletedReceiver"
              android:exported="true"
              android:directBootAware="true">
        <intent-filter android:priority="1000">
            <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
    </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:replace="android:authorities"/>

        <receiver
            android:name=".Startup"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Splash Screen Activity -->
        <activity
            android:name=".xiaomiparts.SplashActivity"
            android:label="@string/xiaomi_parts_title"
            android:icon="@drawable/ic_xiaomiparts"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:exported="true"
            android:screenOrientation="portrait"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/xiaomi_parts_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_xiaomiparts" />
        </activity>

        <!-- XiaomiParts Main Activity -->
        <activity
            android:name=".xiaomiparts.XiaomiPartsActivity"
            android:label="@string/xiaomi_parts_title"
            android:icon="@drawable/ic_xiaomiparts"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
        </activity>

        <!-- Launcher alias -->
        <activity-alias
               android:name=".LauncherAlias"
               android:targetActivity=".xiaomiparts.SplashActivity"
               android:icon="@drawable/ic_launcher_icon"
               android:label="@string/xiaomi_parts_launcher_title"
               android:enabled="true"
               android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Thermal Settings -->
        <activity
            android:name=".thermal.ThermalSettingsActivity"
            android:label="@string/thermal_title"
            android:icon="@drawable/ic_thermal"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
        <service
            android:name=".thermal.ThermalService"
            android:permission="ThermalService">
        </service>
        
        <!-- Thermal Profiles tile service -->
        <service
            android:name=".thermal.ThermalTileService"
            android:label="@string/thermal_tile_label"
            android:icon="@drawable/ic_thermal_enabled"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Dirac Audio -->
        <activity
            android:name=".dirac.DiracActivity"
            android:exported="false"
            android:label="@string/dirac_title"
            android:icon="@drawable/ic_dirac"
            android:theme="@style/Theme.SubSettingsBase"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
        <service
            android:name=".dirac.DiracTileService"
            android:exported="true"
            android:icon="@drawable/ic_headphone"
            android:label="@string/dirac_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE"
            android:value="true" />
        </service>

        <!-- Clear Speaker -->
        <activity
            android:name=".speaker.ClearSpeakerActivity" 
            android:label="@string/clear_speaker_title"
            android:icon="@drawable/ic_clear_speaker"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>

        <!-- Display Saturation -->
        <activity
            android:name=".saturation.SaturationActivity"
            android:label="@string/saturation_title"
            android:icon="@drawable/ic_display_saturation"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>

        <!-- Display Saturation tile service -->
        <service  
            android:name=".saturation.SaturationTileService"
            android:label="@string/saturation_title"
            android:icon="@drawable/ic_saturation_tile"
            android:exported="true"  
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

	<!-- TileHandler activity -->
        <activity
            android:name=".TileHandlerActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Auto HBM -->
        <activity
            android:name=".autohbm.AutoHbmActivity"
            android:label="@string/auto_hbm_title"
            android:icon="@drawable/ic_auto_hbm"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>

        <!-- Auto HBM service -->
        <service
            android:name=".autohbm.AutoHbmService"
            android:exported="false" />

        <!-- Auto HBM tile service -->
        <service
            android:name=".autohbm.AutoHbmTileService"
            android:label="@string/auto_hbm_title"
            android:icon="@drawable/ic_auto_hbm_tile"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--HBM tile service -->
        <service
            android:name=".autohbm.HbmTileService"
            android:label="@string/tile_hbm"
            android:icon="@drawable/ic_hbm_tile"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- GameBar -->
        <activity
            android:name=".gamebar.GameBarSettingsActivity"
            android:label="@string/game_bar_title"
            android:icon="@drawable/ic_gamebar_settings"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>

        <!-- GameBar Overlay Tile Service -->
        <service
            android:name=".gamebar.GameBarTileService"
            android:label="@string/game_bar_tile_label"
            android:icon="@drawable/ic_gamebar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- GameBar Overlay Monitor Service -->
        <service
            android:name=".gamebar.GameBarMonitorService"
            android:exported="false" />

        <!-- GameBar BootReceiver -->
        <receiver
            android:name=".gamebar.GameBarBootReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
             </intent-filter>
        </receiver>

        <!-- Logcat Viewer Activity -->
        <activity
            android:name=".logcatviewer.MainActivity"
            android:label="@string/logcat_viewer_title"
            android:icon="@drawable/ic_logcat"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="true"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>

        <!-- Logcat Background Service -->
        <service
            android:name=".logcatviewer.LogcatBackgroundService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />    
        
        <!-- Turbo Charging -->
        <activity
            android:name=".turbocharging.TurboChargingActivity"
            android:exported="false"
            android:enabled="true"
            android:label="@string/turbo_charge_title"
            android:icon="@drawable/ic_turbo_charging"
            android:theme="@style/Theme.SubSettingsBase"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>

        <service
            android:name=".turbocharging.TurboChargingService"
            android:exported="false"
            android:permission="TurboChargingService">
        </service>

        <!-- Turbo Charging Tile Service -->
        <service
            android:name=".turbocharging.TurboChargingTile"
            android:label="@string/turbo_charge_title"
            android:icon="@drawable/ic_turbo_charging_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
            android:name="android.service.quicksettings.TOGGLEABLE_TILE"
            android:value="true" />
        </service>

        <!-- Turbo Charging BootReceiver -->
        <receiver
            android:name=".turbocharging.TurboChargingBootReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.default" />
             </intent-filter>
        </receiver>

        <!-- About Me -->
        <activity
            android:name=".aboutme.AboutMeActivity"
            android:label="@string/about_me_title"
            android:icon="@drawable/ic_about_me"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
        <!-- Mi AdBlocker -->
        <activity
            android:name=".adblocker.AdBlockerActivity"
            android:label="@string/adblocker_title"
            android:icon="@drawable/ic_adblocker"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
        <!-- Core Control Activity -->
        <activity
            android:name=".corecontrol.CoreControlActivity"
            android:label="@string/core_control_title"
            android:icon="@drawable/ic_core_control"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
        <!-- Charge Bypass -->
        <activity
            android:name=".charge.ChargeActivity"
            android:label="@string/charge_bypass_title"
            android:icon="@drawable/ic_charge_bypass"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
        <!-- Kernel Manager -->
        <activity
            android:name=".kernelmanager.KernelManagerActivity"
            android:label="@string/kernel_manager_title"
            android:icon="@drawable/ic_kernel_manager"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
	<!-- GPU Manager -->
	<activity
            android:name=".gpumanager.GpuManagerActivity"
            android:label="@string/gpu_manager_title"
            android:icon="@drawable/ic_gpu_manager"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        
        <!-- Charging control -->
        <activity
            android:name=".chargecontrol.ChargeControlActivity"
            android:label="@string/charge_control_title"
            android:icon="@drawable/ic_charge_control"
            android:theme="@style/Theme.SubSettingsBase"
            android:exported="false"
            android:parentActivityName=".xiaomiparts.XiaomiPartsActivity">
        </activity>
        <service
            android:name=".chargecontrol.ChargeControlService"
            android:exported="false" />
        <service
            android:name=".chargecontrol.ChargeControlTileService"
            android:label="@string/charge_control_tile_label"
            android:icon="@drawable/ic_charge_control"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <activity
            android:name=".gamebar.GameBarPerAppConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase" />    
         
    </application>
</manifest>
